+    func testContextMenuOpenCopyUsesClickedFileWithoutFilesFocus() throws {
+        let fixture = try WorkspaceUITestFixture(in: self)
+        let targetFile = try fixture.file("menu-target.txt", text: "original\\n")
+        let otherFile = try fixture.file("unrelated.txt", text: "keep\\n")
+        let app = try WorkspaceUITestSupport.launch(in: self, language: "en")
+        try WorkspaceUITestSupport.addFolder(fixture.root, to: app)
+        let window = app.windows.firstMatch
+        let target = WorkspaceUITestSupport.fileRow(targetFile, in: window)
+        let selected = WorkspaceUITestSupport.fileRow(otherFile, in: window)
+        XCTAssertTrue(target.waitForExistence(timeout: 15))
+        XCTAssertTrue(selected.waitForExistence(timeout: 15))
+        selected.click()
+
+        // The terminal is in a separate Dock group; a context click must not activate Files.
+        app.typeKey("t", modifierFlags: .command)
+        window.coordinate(withNormalizedOffset: CGVector(dx: 0.52, dy: 0.60)).click()
+        target.rightClick()
+        XCTAssertTrue(selected.isSelected && !target.isSelected,
+                      "Right-click must not change the persistent selection")
+        XCTAssertTrue(app.menus.allElementsBoundByIndex.contains {
+            $0.menuItems["Copy Relative Path"].exists
+        }, "The native Files context menu must still be tracking")
+        app.typeKey("c", modifierFlags: .command)
+
+        let clipboard = NSPasteboard.general
+        XCTAssertEqual(clipboard.string(forType: .string), targetFile.path)
+        XCTAssertNotNil(clipboard.data(forType:
+            NSPasteboard.PasteboardType("com.chiimagnus.bailey.files.transfer")),
+            "Context-menu Cmd-C must use the Files clipboard even when Terminal owns focus")
+        XCTAssertEqual(try Data(contentsOf: otherFile), Data("keep\\n".utf8))
+        XCTAssertEqual(try Data(contentsOf: targetFile), Data("original\\n".utf8))
+        app.typeKey(XCUIKeyboardKey.escape, modifierFlags: [])
+        let marker = fixture.root.appendingPathComponent("terminal-focus.txt")
+        app.typeText("printf terminal > '\(marker.path)'")
+        app.typeKey(XCUIKeyboardKey.return, modifierFlags: [])
+        let terminalHandledInput = XCTNSPredicateExpectation(predicate: NSPredicate { _, _ in
+            FileManager.default.fileExists(atPath: marker.path)
+        }, object: nil)
+        XCTAssertEqual(XCTWaiter.wait(for: [terminalHandledInput], timeout: 12), .completed,
+                       "Terminal must retain keyboard input after the Files context menu")
+    }
