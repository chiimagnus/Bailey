+    func testContextMenuCopyRestoresEditorShortcutAfterDismissal() throws {
+        let fixture = try WorkspaceUITestFixture(in: self)
+        let editorFile = try fixture.file("editor.txt", text: "editor selection\\n")
+        let menuFile = try fixture.file("menu-file.txt", text: "menu selection\\n")
+        let app = try WorkspaceUITestSupport.launch(in: self, language: "en")
+        try WorkspaceUITestSupport.addFolder(fixture.root, to: app)
+        let window = app.windows.firstMatch
+        let source = WorkspaceUITestSupport.fileRow(editorFile, in: window)
+        let target = WorkspaceUITestSupport.fileRow(menuFile, in: window)
+        XCTAssertTrue(source.waitForExistence(timeout: 15))
+        XCTAssertTrue(target.waitForExistence(timeout: 15))
+        source.doubleClick()
+        let editor = window.textViews.firstMatch
+        XCTAssertTrue(editor.waitForExistence(timeout: 15))
+        editor.click()
+        app.typeKey("a", modifierFlags: .command)
+
+        target.rightClick()
+        XCTAssertTrue(app.menus.allElementsBoundByIndex.contains {
+            $0.menuItems["Copy Relative Path"].exists
+        })
+        app.typeKey("c", modifierFlags: .command)
+        XCTAssertEqual(NSPasteboard.general.string(forType: .string), menuFile.path)
+
+        // After the menu closes, the existing editor selection still owns Cmd-C.
+        XCTAssertFalse(app.menus.allElementsBoundByIndex.contains {
+            $0.menuItems["Copy Relative Path"].exists
+        }, "Native shortcut execution must end the context menu")
+        app.typeKey("c", modifierFlags: .command)
+        XCTAssertEqual(NSPasteboard.general.string(forType: .string), "editor selection\\n")
+        XCTAssertNil(NSPasteboard.general.data(forType:
+            NSPasteboard.PasteboardType("com.chiimagnus.bailey.files.transfer")))
+    }
