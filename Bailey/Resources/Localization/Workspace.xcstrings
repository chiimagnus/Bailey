{
  "sourceLanguage" : "en",
  "strings" : {
    "A name can’t contain “/” or be “.” or “..”." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名称不能包含“/”，也不能是“.”或“..”。"
          }
        }
      }
    },
