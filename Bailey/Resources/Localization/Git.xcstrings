        }
      }
    },
    "Mixed — reset index, keep working files" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mixed — 重置暂存区，保留工作文件"
          }
        }
      }
    },
    "Hard — overwrite index and working files" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard — 覆写暂存区和工作文件"
          }
        }
      }
    },
    "This commit cannot be dropped from the current HEAD without crossing a merge or fork." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 HEAD 到此提交的路径包含合并或分叉，不能删除该提交。"
          }
        }
      }
    },
    "Launch Interactive Rebase" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启动交互式变基"
          }
        }
      }
    },
    "Launch Interactive Rebase in New Terminal" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在新终端启动交互式变基"
          }
        }
      }
    },
    "Ignore Date" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略日期"
          }
        }
      }
    },
    "Ignore Date applies only to non-interactive rebase." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "忽略日期仅适用于非交互式变基。"
          }
        }
      }
    },
    "Yes, Rebase" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是，变基"
          }
        }
      }
    },
    "Yes, Reset" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
