          }
        }
      }
    },
    "The Git action target changed or edits could not be saved. No further Git commands were run." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Git 操作目标已改变或编辑未能保存。未执行后续 Git 命令。"
          }
        }
      }
    },
    "%@ (%lld items were already moved to Trash.)" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ (%lld item was already moved to Trash.)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%@ (%lld items were already moved to Trash.)"
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（其中 %lld 项已在废纸篓中。）"
          }
        }
      }
    },
    "%@ (Staged)" : {
      "comment" : "Tab title for the staged diff of a file.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（已暂存）"
          }
        }
