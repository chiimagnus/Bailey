    },
    "Yes, Drop" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "是，删除"
          }
        }
      }
    },
    "Hard permanently overwrites tracked files and may delete untracked paths obstructing their restoration. Ordinary untracked files are kept." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hard 永久覆写已跟踪文件，也可能删除阻挡恢复的未跟踪路径。普通未跟踪文件会保留。"
          }
        }
      }
    },
    "This rewrites the current HEAD history to remove the selected commit. Your Git rebase configuration still applies." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会改写当前 HEAD 的历史以删除所选提交。仍使用你的 Git 变基配置。"
          }
        }
      }
    },
    "Always Accept" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
