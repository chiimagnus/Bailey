          }
        }
      }
    },
    "Text cannot be saved in %@ without losing characters." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本无法无损保存为 %@ 编码。"
          }
        }
      }
    },
    "Could not refresh file; showing last loaded content." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
