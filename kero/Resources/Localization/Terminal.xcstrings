{
  "sourceLanguage" : "en",
  "strings" : {
    "%@: %@" : {
      "comment" : "Accessibility label for a terminal feature and whether it is available.",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：%@"
          }
        }
      }
    },
    "A program is attempting to read from the clipboard. The current clipboard contents are shown below." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有程序正在尝试读取剪贴板。当前剪贴板内容如下。"
          }
        }
      }
    },
