          }
        }
      }
    },
    "Reopened terminals show their previous scrollback above a fresh shell" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新打开的终端会在新的 Shell 上方显示之前的滚动历史"
