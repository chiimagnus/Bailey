    "Checkout leaves you in detached HEAD. Create a branch to keep new commits." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检出后进入游离 HEAD 状态。请创建分支以保留新提交。"
          }
        }
      }
    },
    "No Commit does not prevent a fast-forward when that is allowed." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许快进时，“不创建提交”不会阻止快进。"
